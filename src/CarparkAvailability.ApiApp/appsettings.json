{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "StaticData": {
    "CsvPath": "Data/HDBCarparkInformation.csv"
  },
  "Availability": {
    "BaseUrl": "https://api.data.gov.sg/v1/",
    "ApiKey": "{{DATA_GOV_SG_API_KEY}}",
    "PollInterval": "00:01:00",
    "FreshnessThreshold": "00:02:00",
    "RequestTimeout": "00:00:10"
  },
  "Search": {
    "RadiusMetres": 500,
    "DistanceWeight": 0.50,
    "AvailabilityWeight": 0.30,
    "OccupancyWeight": 0.20,
    "AvailableLotCap": 20
  },
  "AllowedHosts": "*"
}
