<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="NSwag.MSBuild" PrivateAssets="all" />
    <ProjectReference Include="..\CarparkAvailability.ServiceDefaults\CarparkAvailability.ServiceDefaults.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CarparkApiContract>$(MSBuildProjectDirectory)\..\..\contracts\carpark-availability-api.openapi.yaml</CarparkApiContract>
    <CarparkApiClient>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\Generated\CarparkAvailabilityApiClient.g.cs</CarparkApiClient>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CarparkApiClient)" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateCarparkApiClient"
          BeforeTargets="CoreCompile"
          Inputs="$(CarparkApiContract)"
          Outputs="$(CarparkApiClient)">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\Generated" />
    <Exec Command="$(NSwagExe_Net90) openapi2csclient /input:&quot;$(CarparkApiContract)&quot; /output:&quot;$(CarparkApiClient)&quot; /namespace:CarparkAvailability.WebApp.Generated /classname:CarparkAvailabilityApiClient /UseBaseUrl:false /GenerateClientInterfaces:true /GenerateOptionalParameters:true /JsonLibrary:SystemTextJson" />
  </Target>

</Project>
